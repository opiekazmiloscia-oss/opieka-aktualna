-- Tabela cennika (trwałe przechowywanie cen)
CREATE TABLE IF NOT EXISTS prices (
    service_key TEXT PRIMARY KEY,
    price NUMERIC NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now())
);

